{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "trailingComma": "all",
  "sortTailwindcss": true,
  "sortImports": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "ignorePatterns": ["dist", "node_modules", ".vite", "coverage"]
}
